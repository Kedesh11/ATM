<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Source NuGet officielle — forcée en IPv4 via le nom de résolution -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Timeout étendu pour les environnements à connexion lente -->
    <add key="http_proxy.user" value="" />
    <add key="requestTimeout" value="300" />
    <add key="downloadTimeout" value="300" />
  </config>
</configuration>
